{
  "schema_version": 1,
  "id": "professional_visual_quality_gate",
  "purpose": "Reject technically or contractually weak visual masters before private upload.",
  "design_system": "config/channel_design_system.json",
  "asset_medium_rules": {
    "channel_cover": "MODERN_EDITORIAL_BRAND_DESIGN_NO_ILLUSTRATION",
    "video_visuals": "MODERN_REFERENCE_BASED_ILLUSTRATION_ALLOWED",
    "anime": "FORBIDDEN"
  },
  "required_aspect_ratio": "16:9",
  "minimum_resolution": [1920, 1080],
  "allowed_effect_profiles": [
    "approved_plate_localized_atmosphere",
    "approved_plate_window_reflections",
    "approved_plate_coffee_steam",
    "integrated_plate-extracted-rain-texture-steam-reflections",
    "masked-window-exterior-rain-steam-reflections",
    "static-window-rain-steam-only",
    "steam_only-steam-reflections"
  ],
  "required_provenance": [
    "approved_image_sha256",
    "video_sha256",
    "motion_profile",
    "camera",
    "scene_count"
  ],
  "hard_rules": {
    "scene_count": 1,
    "camera": "locked",
    "publication": "DISABLED",
    "no_full_frame_particle_overlay": true,
    "no_camera_motion": true
  }
}
