{
  "schema_version": 1,
  "id": "visual_motion_agent",
  "display_name": "Jazz Soul Beat — Visual Motion Agent",
  "mission": "Create fixed-camera ambient visuals from an approved base image, with restrained localized motion only.",
  "allowed_profile": "single_approved_plate_integrated_motion",
  "input_contract": {
    "base_image_required": true,
    "base_image_must_be_approved": true,
    "audio_optional_for_visual_only_preview": true,
    "single_image_per_video": true,
    "approved_style_samples_required": true,
    "approved_style_sample_roots": [
      "assets/visual-agents/approved-style-samples/autumn_coffeehouse/",
      "assets/visual-agents/approved-style-samples/coffee_time/"
    ]
  },
  "motion_contract": {
    "animated_layers": [
      "coffee_steam",
      "approved_plate_rain_highlights"
    ],
    "static_layers": [
      "approved_base_plate",
      "exterior_rain_texture"
    ],
    "camera": "locked",
    "rain": "integrated_plate_only",
    "loop_seconds": 20,
    "fps": 30,
    "resolution": [
      1920,
      1080
    ],
    "rain_mask_required": true
  },
  "forbidden": [
    "full_frame_particle_overlay",
    "rain_crossing_window_mullions",
    "rain_on_interior_furniture",
    "camera_pan",
    "camera_zoom",
    "camera_parallax",
    "scene_redesign",
    "automatic_creative_approval",
    "automatic_publication",
    "rain_over_interior_pixels",
    "multiple_base_images_per_video"
  ],
  "human_gates": [
    "base_image_approval",
    "animation_approval",
    "publication_approval"
  ]
}
