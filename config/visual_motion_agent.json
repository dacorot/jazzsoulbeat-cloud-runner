{
  "schema_version": 2,
  "id": "visual_motion_agent",
  "display_name": "Jazz Soul Beat — Visual Motion Agent",
  "mission": "Create fixed-camera ambient visuals from an approved base image, with restrained localized motion only.",
  "design_line": {
    "name": "modern_cinematic_editorial",
    "source_of_truth": "config/channel_design_system.json",
    "status": "ACTIVE",
    "principles": [
      "clean contemporary composition",
      "deliberate negative space",
      "refined architectural and material detail",
      "controlled cinematic lighting",
      "distinct scene concept per video",
      "remain bound to the approved reference set"
    ],
    "allowed_by_asset": {
      "channel_cover": "modern_editorial_brand_design_no_illustration",
      "video_assets": "modern_reference_based_editorial_illustration"
    },
    "must_not_become": ["anime", "manga", "chibi", "childish character styling", "comic linework", "neon cyberpunk", "glossy 3D", "generic stock art", "generic lo-fi collage", "visual clutter"]
  },
  "allowed_profile": "single_approved_plate_integrated_motion",
  "input_contract": {
    "base_image_required": true,
    "base_image_must_be_approved": true,
    "audio_optional_for_visual_only_preview": true
  },
  "motion_contract": {
    "animated_layers": ["coffee_steam", "approved_plate_rain_highlights"],
    "static_layers": ["approved_base_plate"],
    "camera": "locked",
    "rain": "integrated_plate_only",
    "rain_mask_required": true,
    "rain_placement": "verified_window_mask_only",
    "loop_seconds": 20,
    "fps": 30,
    "resolution": [1920, 1080]
  },
  "professional_effect_stack": {
    "required": true,
    "profiles": [
      "approved_plate_localized_atmosphere",
      "approved_plate_window_reflections",
      "approved_plate_coffee_steam"
    ],
    "principles": [
      "locked_camera",
      "effect_is_scene_masked",
      "no_full_frame_overlays",
      "no_unmotivated_motion",
      "no_effect_crosses_subject_boundaries",
      "subtle_animated_exposure_only_when_scene_manifest_allows_it"
    ],
    "minimum_base_resolution": [1920, 1080],
    "output_aspect_ratio": "16:9",
    "render_review_required": true
  },
  "forbidden": [
    "full_frame_particle_overlay",
    "rain_crossing_window_mullions",
    "rain_on_interior_furniture",
    "camera_pan",
    "camera_zoom",
    "camera_parallax",
    "scene_redesign",
    "automatic_creative_approval",
    "automatic_publication"
  ],
  "automated_gates": ["base_image_technical_qa", "effect_manifest_qa", "animation_render_qa"],
  "human_gates": ["publication_approval"]
}

