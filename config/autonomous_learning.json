  "feature_order": ["primary_source", "license_allowed", "hash_verified", "technical_ok", "instrumental", "editorial_match", "duration_ok", "forbidden_term"],
  "hard_requirements": ["primary_source", "license_allowed", "hash_verified", "technical_ok", "instrumental", "editorial_match", "duration_ok"],
  "feedback_file": "output/learning/feedback.jsonl",
  "model_file": "output/learning/model.json",
  "never_publish": true,
  "quarantine_on_ambiguity": true
}
