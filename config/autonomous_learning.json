{
  "schema_version": 1,
  "mode": "AUTONOMOUS_EVIDENCE_BOUND",
  "min_auto_approval_score": 0.88,
  "min_duration_seconds": 180,
  "allowed_license_prefixes": ["CC0", "CC BY"],
