{
  "schema_version": 1,
  "agent_id": "music_search_agent",
  "mission": "Find and privately approve only soft jazz, smooth jazz and instrumental lo-fi that match Jazz Soul Beat's editorial identity.",
  "target_genres": ["jazz", "smooth jazz", "soft jazz", "lofi", "lo-fi"],
  "minimum_candidate_duration_seconds": 180,
  "allowed_license_claims": ["CC0 1.0", "CC BY 1.0", "CC BY 2.0", "CC BY 2.5", "CC BY 3.0", "CC BY 4.0"],
  "required_rights_states": ["pending_primary_source_and_rights_review"],
  "reject_terms": ["funk", "funky", "groove", "jazz-funk", "dance", "party", "disco", "shuffle", "swing", "vocal", "voice", "lyrics", "remix", "mashup", "sample pack", "live concert", "podcast", "sermon", "lecture", "speech", "audiobook", "interview", "news", "soundtrack", "worship", "preaching"],
  "never_auto_approve": false,
  "approval_mode": "AUTONOMOUS_EVIDENCE_BOUND",
  "auto_approval_requires": ["primary_source", "license_allowed", "hash_verified", "technical_qc_pass", "instrumental", "editorial_match", "no_reject_terms"],
  "never_download_audio": true,
  "never_publish": true,
  "dedup_required_before_download": true,
  "dedup_keys": ["sha256", "source_url", "title_creator_duration"]
}
